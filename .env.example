DATABASE_URL=postgresql://watchrail:watchrail@localhost:5433/watchrail
REDIS_URL=redis://localhost:6379
DEV_IDENTITY_ENABLED=true
HTTP_HEADER_ACTIVE_KEY_ID=v1
# Keep retired keys until every envelope using them has been replaced or rewrapped.
HTTP_HEADER_ENCRYPTION_KEYS={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
ASSERTION_ACTIVE_KEY_ID=v1
# Keep retired keys until every assertion envelope using them has been replaced or rewrapped.
ASSERTION_ENCRYPTION_KEYS={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
WEBHOOK_SIGNING_SECRET_ACTIVE_KEY_ID=v1
# Keep retired keys until every webhook endpoint version and pending delivery using them has retired.
WEBHOOK_SIGNING_SECRET_ENCRYPTION_KEYS={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
PORT=4000
API_URL=http://localhost:4000
# URL of the Next.js frontend (used by API for CORS and auth redirects).
FRONTEND_URL=http://localhost:3000
# Additional comma-separated browser origins accepted by Better Auth.
# Useful when running Next.js on a non-default local port.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3010
# Shared only by the API and Next.js server. Never expose this as NEXT_PUBLIC_*.
PUBLIC_STATUS_PAGE_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
SCHEDULE_DISPATCH_BATCH_SIZE=100
SCHEDULE_IDLE_POLL_INTERVAL_MS=1000
PROBE_RECONCILIATION_BATCH_SIZE=100
PROBE_RECONCILIATION_INTERVAL_MS=1000
PROBE_PENDING_ASSIGNMENT_TIMEOUT_MS=120000
MULTI_LOCATION_EXECUTION_ENABLED=false
NEXT_PUBLIC_MULTI_LOCATION_EXECUTION_ENABLED=false
AVAILABILITY_FLUSH_BATCH_SIZE=100
AVAILABILITY_FLUSH_INTERVAL_MS=60000
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_DELIVERY_LEASE_DURATION_MS=30000
WEBHOOK_DELIVERY_MAX_ATTEMPTS=8
WEBHOOK_DELIVERY_RETRY_BASE_MS=5000
WEBHOOK_DELIVERY_RETRY_MAX_MS=300000
WEBHOOK_DELIVERY_CONCURRENCY=5
WEBHOOK_DELIVERY_IDLE_POLL_INTERVAL_MS=500
# Standalone remote probe agent (deploy separately from API/worker).
# The agent intentionally does not use DATABASE_URL, REDIS_URL, or encryption keyrings.
PROBE_COORDINATOR_URL=https://watchrail.example.com
PROBE_MACHINE_CREDENTIAL=
# Bootstrap alternative: set both once instead of PROBE_MACHINE_CREDENTIAL.
PROBE_ENROLLMENT_ID=
PROBE_ENROLLMENT_TOKEN=
PROBE_CREDENTIAL_FILE=/run/secrets/watchrail-probe-credential
PROBE_POLL_INTERVAL_MS=5000
PROBE_HEARTBEAT_INTERVAL_MS=15000
PROBE_RENEWAL_INTERVAL_MS=10000
PROBE_COORDINATOR_REQUEST_TIMEOUT_MS=10000

# ─── Identity & Authentication (Better Auth) ─────────────────────────────────
# At least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-chars
# Public URL of the NestJS API (used by Better Auth for redirects / CORS).
BETTER_AUTH_URL=http://localhost:4000

# GitHub OAuth — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitLab OAuth — create at https://gitlab.com/-/profile/applications
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP — how long (in seconds) a verification code is valid.
AUTH_OTP_EXPIRES_IN_SECONDS=600

# ─── Mail delivery ────────────────────────────────────────────────────────────
# MAIL_PROVIDER: "console" (dev — prints to stdout) | "smtp"
MAIL_PROVIDER=console
MAIL_FROM=Watchrail <noreply@watchrail.dev>
# Development only. Never enable in production or shared logs.
MAIL_CONSOLE_SHOW_OTP=false
# SMTP settings (only needed when MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
