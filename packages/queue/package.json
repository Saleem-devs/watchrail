{
  "name": "@watchrail/queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --exclude '**/*.integration.spec.ts' --passWithNoTests",
    "test:integration": "vitest run src/*.integration.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@watchrail/contracts": "workspace:*",
    "bullmq": "6.3.8",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@testcontainers/redis": "12.1.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
