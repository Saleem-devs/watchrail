{
  "name": "@watchrail/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "lint": "eslint src drizzle.config.ts --max-warnings 0",
    "test:migrations": "vitest run src/migrations.migration.spec.ts",
    "test:integration": "vitest run src/manual-round-repository.integration.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@watchrail/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.1",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
