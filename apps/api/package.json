{
  "name": "@watchrail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test --max-warnings 0",
    "start": "node dist/main.js",
    "test": "vitest run --exclude '**/*.integration.spec.ts'",
    "test:integration": "pnpm --filter @watchrail/probe-agent build && vitest run --dir test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/drizzle": "0.0.1",
    "@nestjs/platform-express": "12.1.0",
    "@watchrail/assertion-security": "workspace:*",
    "@watchrail/contracts": "workspace:*",
    "@watchrail/db": "workspace:*",
    "@watchrail/domain": "workspace:*",
    "@watchrail/http-header-security": "workspace:*",
    "@watchrail/webhook-security": "workspace:*",
    "better-auth": "^1.7.10",
    "dotenv": "18.0.1",
    "express": "5.2.1",
    "nodemailer": "^10.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "7.2.1",
    "drizzle-orm": "0.45.2",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
